{
  "name": "furever-home",
  "version": "1.0.0",
  "private": true,
  "description": "Furever Home \u2014 a one-page cat adoption website",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:preview": "node scripts/build.mjs",
    "start": "npm run build && node scripts/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "configure-domain": "node scripts/configure-domain.mjs",
    "worker:deploy": "wrangler deploy --config oauth-worker/wrangler.toml",
    "worker:check": "wrangler deploy --dry-run --config oauth-worker/wrangler.toml --outdir /tmp/furever-worker-check"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "decap-cms": "3.16.3",
    "wrangler": "4.149.0"
  }
}
